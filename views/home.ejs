<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="A free api to get quotes.">
  <meta name="keywords" content="quotes, uzumaki, naruto, onepiece, ,quote, api, anime, rapid api, ninja, zen, zen quotes api, aen quotes, anime quotes, motivational quotes, motivation, motivational, Quotes, API, Quotes API, Siddharth, Siddharth Jain, HTML, CSS, JavaScript">
  <meta name="author" content="Siddharth Jain">
  <link rel="stylesheet" href="css/home.css">
  <link rel="icon" type="image/x-icon" href="css/logo.png">
  <title>Quotes API</title>
</head>
<body>
  <div class="header">
  <h1 class="text-3xl font-semibold log"><a href="/"><img class="pro" src="css/logo.png"></a>Quotes API Documentation</h1>
</div>

<div class="container">
  <div class="section">
    <h3 class="text-xl font-semibold">All Endpoints</h3>
    <code class="bg-gray-200">
      GET /quote/random
    </code>
   <div></div>
    <code class="bg-gray-200">
      GET /quote/author-name
    </code>
    
    <h3 class="text-xl font-semibold">NOTE</h3>
    <p class="text-gray-700">Author name is case sensitive.</p>
  </div>      
  
  <div class="section">
    <h2 class="text-2xl font-semibold">Endpoint 1: /quote/random</h2>
    <p class="text-gray-700">This endpoint will get random quote.</p>

    <h3 class="text-xl font-semibold">HTTP Request</h3>
    <code class="bg-gray-200">
      GET /quote/random
    </code>

    <h3 class="text-xl font-semibold">Example</h3>
    <p class="text-gray-700">https://quotesapi25.onrender.com/quote/random</p>
    <h3 class="text-xl font-semibold">Response</h3>
    <code class="bg-gray-200">
      {
        "quoteText": "By believing passionately in something that does not yet exist, we create it.",
        "quoteAuthor": "Nikos Kazantzakis"
      }
    </code>
  </div>

  <div class="section">
    <h2 class="text-2xl font-semibold">Endpoint 2: /quote/author_name</h2>
    <p class="text-gray-700">This endpoint will get random quote of the specified author.</p>

    <h3 class="text-xl font-semibold">HTTP Request</h3>
    <code class="bg-gray-200">
      GET /quote/author_name
    </code>

    <h3 class="text-xl font-semibold">Example</h3>
    <p class="text-gray-700">https://quotesapi25.onrender.com/quote/Buddha</p>

    <h3 class="text-xl font-semibold">Response</h3>
    <code class="bg-gray-200">
      {
          "quoteText": "You will not be punished for your anger, you will be punished by your anger.",
          "quoteAuthor": "Buddha"
      }
    </code>
    <h3 class="text-xl font-semibold">NOTE</h3>
    <p class="text-gray-700">Author name is case sensitive</p>
  </div>
</div>

<div id="footer">
    <script>
        document.getElementById('footer').innerHTML =' Created with ❤️ by <a href="https://siddharth.is-a.dev" target="_blank">Siddharth Jain</a> ' + '&copy; ' + new Date().getFullYear();
    </script>
</div>
</body>
</html>
